"use client";

import { FormEvent, useMemo, useState } from "react";
import QRCode from "qrcode";

type View = "overview" | "companies" | "tables" | "orders" | "menu" | "team" | "finance" | "settings" | "customer";
type Portal = "superadmin" | "owner" | "staff" | "kitchen" | "cashier" | "customer";
type TableState = "available" | "open" | "bill_requested";
type OrderState = "pending" | "accepted" | "preparing" | "ready" | "served" | "rejected" | "voided";

type Company = { id: number; name: string; owner: string; email: string; status: "Active" | "Pending"; tables: number };
type DiningTable = { id: number; label: string; seats: number; state: TableState; token?: string; openedAt?: string };
type MenuItem = { id: number; name: string; description: string; price: number; category: string; available: boolean };
type CartItem = MenuItem & { quantity: number };
type Order = { id: string; table: string; items: string; total: number; state: OrderState; time: string };

const money = (value: number) => new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(value);
const initialMenu: MenuItem[] = [
  { id: 1, name: "Fire-roasted chicken", description: "Herb jus, crispy potatoes and seasonal greens", price: 24, category: "Mains", available: true },
  { id: 2, name: "Wild mushroom rigatoni", description: "Parmesan cream, thyme and toasted hazelnuts", price: 19, category: "Mains", available: true },
  { id: 3, name: "Charred corn ribs", description: "Smoked lime butter and chilli salt", price: 11, category: "Small plates", available: true },
  { id: 4, name: "Burrata & tomatoes", description: "Basil oil, aged balsamic and sourdough", price: 15, category: "Small plates", available: true },
  { id: 5, name: "Burnt honey cheesecake", description: "Vanilla cream and citrus", price: 10, category: "Dessert", available: true },
  { id: 6, name: "House lemonade", description: "Fresh lemon, mint and sparkling water", price: 5, category: "Drinks", available: true },
];

const initialTables: DiningTable[] = [
  { id: 1, label: "Table 01", seats: 2, state: "open", token: "ember-t01-demo-session", openedAt: "12:42" },
  { id: 2, label: "Table 02", seats: 4, state: "available" },
  { id: 3, label: "Table 03", seats: 4, state: "bill_requested", token: "ember-t03-demo-session", openedAt: "11:58" },
  { id: 4, label: "Table 04", seats: 6, state: "available" },
  { id: 5, label: "Table 05", seats: 2, state: "open", token: "ember-t05-demo-session", openedAt: "13:04" },
  { id: 6, label: "Patio 01", seats: 4, state: "available" },
];

const initialOrders: Order[] = [
  { id: "#1048", table: "Table 01", items: "2 × Fire-roasted chicken, 1 × House lemonade", total: 53, state: "pending", time: "2 min ago" },
  { id: "#1047", table: "Table 05", items: "1 × Wild mushroom rigatoni, 1 × Burrata & tomatoes", total: 34, state: "accepted", time: "6 min ago" },
  { id: "#1046", table: "Table 03", items: "2 × Charred corn ribs, 2 × House lemonade", total: 32, state: "ready", time: "18 min ago" },
];

const navByPortal: Record<Portal, { id: View; label: string; icon: string }[]> = {
  superadmin: [
    { id: "overview", label: "Platform", icon: "⌂" },
    { id: "companies", label: "Companies", icon: "▦" },
    { id: "settings", label: "Settings", icon: "⚙" },
  ],
  owner: [
    { id: "overview", label: "Overview", icon: "⌂" }, { id: "tables", label: "Tables", icon: "▦" },
    { id: "orders", label: "Orders", icon: "◫" }, { id: "menu", label: "Menu", icon: "≡" },
    { id: "team", label: "Team", icon: "♙" }, { id: "finance", label: "Finances", icon: "$" },
    { id: "settings", label: "Settings", icon: "⚙" },
  ],
  staff: [
    { id: "overview", label: "Overview", icon: "⌂" }, { id: "tables", label: "Tables", icon: "▦" },
    { id: "orders", label: "Orders", icon: "◫" }, { id: "menu", label: "Menu", icon: "≡" },
  ],
  kitchen: [{ id: "orders", label: "Kitchen board", icon: "◫" }],
  cashier: [{ id: "tables", label: "Tables", icon: "▦" }, { id: "finance", label: "Payments", icon: "$" }],
  customer: [{ id: "customer", label: "Menu", icon: "≡" }],
};

export function DineQRApp() {
  const [portal, setPortal] = useState<Portal>("superadmin");
  const [view, setView] = useState<View>("overview");
  const [companyName, setCompanyName] = useState("Ember & Oak");
  const [companies, setCompanies] = useState<Company[]>([
    { id: 1, name: "Ember & Oak", owner: "Jordan Ellis", email: "jordan@emberandoak.com", status: "Active", tables: 6 },
    { id: 2, name: "Salt & Stone", owner: "Maya Rivera", email: "maya@saltandstone.com", status: "Active", tables: 12 },
    { id: 3, name: "Little Fig", owner: "Noah Bennett", email: "noah@littlefig.com", status: "Pending", tables: 0 },
  ]);
  const [tables, setTables] = useState(initialTables);
  const [orders, setOrders] = useState(initialOrders);
  const [menu, setMenu] = useState(initialMenu);
  const [cart, setCart] = useState<CartItem[]>([]);
  const [modal, setModal] = useState<"company" | "qr" | "receipt" | "menu" | null>(null);
  const [selectedTable, setSelectedTable] = useState<DiningTable | null>(null);
  const [qrData, setQrData] = useState("");
  const [toast, setToast] = useState("");
  const [tax, setTax] = useState("8.5");
  const [serviceKind, setServiceKind] = useState("percentage");
  const [service, setService] = useState("10");

  const showToast = (message: string) => {
    setToast(message);
    window.setTimeout(() => setToast(""), 2600);
  };

  const switchPortal = (next: Portal) => {
    setPortal(next);
    setView(next === "customer" ? "customer" : next === "kitchen" ? "orders" : next === "cashier" ? "tables" : "overview");
  };

  const openTable = async (table: DiningTable) => {
    const token = `${companyName.toLowerCase().replace(/[^a-z0-9]/g, "")}-${table.id}-${crypto.randomUUID()}`;
    const updated = { ...table, state: "open" as const, token, openedAt: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }) };
    setTables((items) => items.map((item) => item.id === table.id ? updated : item));
    setSelectedTable(updated);
    const basePath = process.env.NEXT_PUBLIC_BASE_PATH ?? "";
    const url = `${window.location.origin}${basePath}/?session=${token}`;
    setQrData(await QRCode.toDataURL(url, { width: 360, margin: 2, color: { dark: "#17241d", light: "#ffffff" } }));
    setModal("qr");
  };

  const showTableQr = async (table: DiningTable) => {
    if (!table.token) return;
    setSelectedTable(table);
    const basePath = process.env.NEXT_PUBLIC_BASE_PATH ?? "";
    setQrData(await QRCode.toDataURL(`${window.location.origin}${basePath}/?session=${table.token}`, { width: 360, margin: 2, color: { dark: "#17241d", light: "#ffffff" } }));
    setModal("qr");
  };

  const closeTable = (table: DiningTable) => {
    if (orders.some((order) => order.table === table.label && order.state === "pending")) {
      showToast("Resolve pending orders before closing this table.");
      return;
    }
    setSelectedTable(table);
    setTables((items) => items.map((item) => item.id === table.id ? { ...item, state: "available", token: undefined, openedAt: undefined } : item));
    setModal("receipt");
  };

  const updateOrder = (id: string, state: OrderState) => {
    setOrders((items) => items.map((item) => item.id === id ? { ...item, state } : item));
    showToast(state === "rejected" ? "Order rejected." : `Order moved to ${state}.`);
  };

  const addToCart = (item: MenuItem) => {
    setCart((items) => {
      const existing = items.find((entry) => entry.id === item.id);
      return existing ? items.map((entry) => entry.id === item.id ? { ...entry, quantity: entry.quantity + 1 } : entry) : [...items, { ...item, quantity: 1 }];
    });
    showToast(`${item.name} added to cart.`);
  };

  const cartSubtotal = useMemo(() => cart.reduce((total, item) => total + item.price * item.quantity, 0), [cart]);
  const billSubtotal = selectedTable ? orders.filter((order) => order.table === selectedTable.label && !["pending", "rejected", "voided"].includes(order.state)).reduce((sum, order) => sum + order.total, 0) : 0;
  const taxAmount = billSubtotal * (Number(tax || 0) / 100);
  const serviceAmount = serviceKind === "percentage" ? billSubtotal * (Number(service || 0) / 100) : Number(service || 0);

  const submitCustomerOrder = () => {
    if (!cart.length) return;
    const order: Order = {
      id: `#${1049 + orders.length}`,
      table: tables.find((table) => table.state === "open")?.label ?? "Table 01",
      items: cart.map((item) => `${item.quantity} × ${item.name}`).join(", "),
      total: cartSubtotal,
      state: "pending",
      time: "Just now",
    };
    setOrders((items) => [order, ...items]);
    setCart([]);
    showToast("Order sent to your waiter for approval.");
  };

  const submitCompany = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    const data = new FormData(event.currentTarget);
    const name = String(data.get("company"));
    setCompanies((items) => [{ id: Date.now(), name, owner: String(data.get("owner")), email: String(data.get("email")), status: "Pending", tables: 0 }, ...items]);
    setCompanyName(name);
    setModal(null);
    showToast(`${name} created. Owner invitation is ready.`);
  };

  const title = view === "overview" ? (portal === "superadmin" ? "Platform overview" : "Good afternoon") : view.charAt(0).toUpperCase() + view.slice(1);
  const subtitle = portal === "superadmin" ? "Manage every restaurant on DineQR." : `${companyName} · Saturday, 18 July`;

  return (
    <div className={`app-shell ${portal === "customer" ? "customer-shell" : ""}`}>
      {portal !== "customer" && (
        <aside className="sidebar">
          <button className="brand" onClick={() => setView("overview")} aria-label="DineQR home"><span className="brand-mark">D</span><span>DineQR</span></button>
          <div className="workspace-card">
            <span className="workspace-avatar">{portal === "superadmin" ? "DQ" : companyName.slice(0, 2).toUpperCase()}</span>
            <span><small>{portal === "superadmin" ? "SUPER ADMIN" : "RESTAURANT"}</small><strong>{portal === "superadmin" ? "DineQR Platform" : companyName}</strong></span>
          </div>
          <nav aria-label="Main navigation">
            {navByPortal[portal].map((item) => (
              <button key={item.id} className={view === item.id ? "active" : ""} onClick={() => setView(item.id)}><span>{item.icon}</span>{item.label}</button>
            ))}
          </nav>
          <div className="sidebar-bottom"><div className="support-card"><span>Need help?</span><small>Visit the DineQR guide</small><button>Open support</button></div><div className="user-row"><span className="user-avatar">AM</span><span><strong>Alex Morgan</strong><small>{portal === "superadmin" ? "Super Admin" : "Owner"}</small></span><button aria-label="Account menu">•••</button></div></div>
        </aside>
      )}

      <main className="main">
        {portal !== "customer" && (
          <header className="topbar">
            <div><h1>{title}</h1><p>{subtitle}</p></div>
            <div className="topbar-actions"><label className="portal-switch"><span>Preview as</span><select value={portal} onChange={(e) => switchPortal(e.target.value as Portal)}><option value="superadmin">Super Admin</option><option value="owner">Owner</option><option value="staff">Waiter</option><option value="kitchen">Kitchen</option><option value="cashier">Cashier</option><option value="customer">Customer</option></select></label><button className="icon-button" aria-label="Notifications">●<span className="notification-dot" /></button></div>
          </header>
        )}

        <div className="content">
          {view === "overview" && portal === "superadmin" && <SuperAdminOverview companies={companies} onAdd={() => setModal("company")} onCompanies={() => setView("companies")} />}
          {view === "companies" && <Companies companies={companies} onAdd={() => setModal("company")} onOpen={(name) => { setCompanyName(name); switchPortal("owner"); }} />}
          {view === "overview" && portal !== "superadmin" && <RestaurantOverview company={companyName} tables={tables} orders={orders} onTables={() => setView("tables")} onOrders={() => setView("orders")} />}
          {view === "tables" && <TablesView tables={tables} onOpen={openTable} onQr={showTableQr} onClose={closeTable} cashier={portal === "cashier"} />}
          {view === "orders" && <OrdersView orders={orders} portal={portal} onUpdate={updateOrder} />}
          {view === "menu" && <MenuView menu={menu} onToggle={(id) => setMenu((items) => items.map((item) => item.id === id ? { ...item, available: !item.available } : item))} onAdd={() => setModal("menu")} />}
          {view === "team" && <TeamView />}
          {view === "finance" && <FinanceView />}
          {view === "settings" && portal === "superadmin" && <PlatformSettings />}
          {view === "settings" && portal !== "superadmin" && <RestaurantSettings company={companyName} setCompany={setCompanyName} tax={tax} setTax={setTax} service={service} setService={setService} serviceKind={serviceKind} setServiceKind={setServiceKind} />}
          {view === "customer" && <CustomerMenu company={companyName} menu={menu} cart={cart} subtotal={cartSubtotal} onAdd={addToCart} onOrder={submitCustomerOrder} onExit={() => switchPortal("owner")} onRequest={(type) => showToast(`${type} request sent to ${companyName}.`)} />}
        </div>
      </main>

      {modal === "company" && <Modal title="Add a restaurant company" onClose={() => setModal(null)}><form className="form-grid" onSubmit={submitCompany}><label>Company name<input name="company" required placeholder="e.g. Ember & Oak" /></label><label>Owner full name<input name="owner" required placeholder="e.g. Jordan Ellis" /></label><label className="full">Owner email<input name="email" type="email" required placeholder="owner@restaurant.com" /></label><div className="modal-actions full"><button type="button" className="button secondary" onClick={() => setModal(null)}>Cancel</button><button className="button primary">Create company</button></div></form></Modal>}
      {modal === "qr" && selectedTable && <Modal title={`${selectedTable.label} is open`} onClose={() => setModal(null)}><div className="qr-modal"><span className="success-pill">● ACTIVE SESSION</span><h3>{companyName}</h3><p>Give this single-use QR code to the guests at {selectedTable.label}.</p>{qrData && <img src={qrData} alt={`QR code for ${selectedTable.label}`} />}<small>Session opened at {selectedTable.openedAt}. This link expires when the table closes.</small><div className="modal-actions"><button className="button secondary" onClick={() => { setModal(null); switchPortal("customer"); }}>Preview menu</button><button className="button primary" onClick={() => window.print()}>Print QR code</button></div></div></Modal>}
      {modal === "receipt" && selectedTable && <Modal title="Final receipt" onClose={() => setModal(null)}><div className="receipt"><div className="receipt-brand"><span className="brand-mark">D</span><h3>{companyName}</h3><p>{selectedTable.label} · Session closed</p></div><div className="receipt-lines"><span>Accepted orders <b>{money(billSubtotal)}</b></span><span>Tax {tax ? `(${tax}%)` : "—"}<b>{tax ? money(taxAmount) : "—"}</b></span><span>Service charge<b>{service ? money(serviceAmount) : "—"}</b></span><span className="receipt-total">Total<b>{money(billSubtotal + taxAmount + serviceAmount)}</b></span><span>Payment method<b>Card</b></span></div><p className="receipt-note">The previous QR link has expired permanently.</p><button className="button primary full-button" onClick={() => window.print()}>Print receipt</button></div></Modal>}
      {modal === "menu" && <Modal title="Add menu item" onClose={() => setModal(null)}><form className="form-grid" onSubmit={(e) => { e.preventDefault(); const data = new FormData(e.currentTarget); setMenu((items) => [...items, { id: Date.now(), name: String(data.get("name")), description: String(data.get("description")), category: String(data.get("category")), price: Number(data.get("price")), available: true }]); setModal(null); showToast("Menu item added."); }}><label>Item name<input name="name" required /></label><label>Category<select name="category"><option>Mains</option><option>Small plates</option><option>Dessert</option><option>Drinks</option></select></label><label className="full">Description<textarea name="description" required rows={3} /></label><label>Price (USD)<input name="price" type="number" min="0" step="0.01" required /></label><div className="modal-actions full"><button type="button" className="button secondary" onClick={() => setModal(null)}>Cancel</button><button className="button primary">Add item</button></div></form></Modal>}
      {toast && <div className="toast">✓ {toast}</div>}
    </div>
  );
}

function SuperAdminOverview({ companies, onAdd, onCompanies }: { companies: Company[]; onAdd: () => void; onCompanies: () => void }) {
  return <><div className="hero-panel"><div><span className="eyebrow">DINEQR CONTROL CENTRE</span><h2>Restaurants thrive.<br />You stay in control.</h2><p>Create restaurant companies, invite their owners, and keep an eye on the entire platform from one calm workspace.</p><div className="hero-actions"><button className="button light" onClick={onAdd}>＋ Add company</button><button className="button ghost-light" onClick={onCompanies}>View all companies</button></div></div><div className="hero-visual"><div className="orbit orbit-one" /><div className="orbit orbit-two" /><div className="hero-logo">D<span>Q</span></div><span className="float-card card-a">12 active tables</span><span className="float-card card-b">+18.4% this month</span></div></div><section className="section"><div className="section-head"><div><h2>Platform at a glance</h2><p>Live performance across every DineQR company.</p></div></div><div className="metric-grid"><Metric label="Restaurant companies" value={String(companies.length)} delta="+1 this month" icon="▦" /><Metric label="Active table sessions" value="28" delta="Across 3 companies" icon="◉" /><Metric label="Orders today" value="184" delta="↑ 12.6% from Friday" icon="◫" /><Metric label="Processed offline" value="$8,420" delta="Recorded today" icon="$" /></div></section><section className="section split"><div className="panel"><div className="section-head"><div><h2>Recent companies</h2><p>Newest restaurants on your platform.</p></div><button className="text-button" onClick={onCompanies}>View all →</button></div><CompanyTable companies={companies.slice(0, 3)} /></div><div className="panel activity"><div className="section-head"><div><h2>Live activity</h2><p>What is happening right now.</p></div></div><Activity color="orange" title="New order at Ember & Oak" note="Table 01 · $53.00 · 2 min ago" /><Activity color="green" title="Table closed at Salt & Stone" note="Table 08 · $126.40 · 8 min ago" /><Activity color="blue" title="Owner invitation accepted" note="Little Fig · 24 min ago" /></div></section></>;
}

function Companies({ companies, onAdd, onOpen }: { companies: Company[]; onAdd: () => void; onOpen: (name: string) => void }) {
  return <section className="section"><div className="section-head"><div><h2>Restaurant companies</h2><p>Create a company, assign its owner, and manage access.</p></div><button className="button primary" onClick={onAdd}>＋ Add company</button></div><div className="panel"><CompanyTable companies={companies} onOpen={onOpen} /></div></section>;
}

function CompanyTable({ companies, onOpen }: { companies: Company[]; onOpen?: (name: string) => void }) {
  return <div className="data-table"><div className="table-row table-head"><span>Company</span><span>Owner</span><span>Status</span><span>Tables</span><span /></div>{companies.map((company) => <div className="table-row" key={company.id}><span className="company-cell"><i>{company.name.slice(0, 2).toUpperCase()}</i><span><strong>{company.name}</strong><small>{company.email}</small></span></span><span>{company.owner}</span><span><em className={`status ${company.status.toLowerCase()}`}>● {company.status}</em></span><span>{company.tables || "—"}</span><span>{onOpen && <button className="text-button" onClick={() => onOpen(company.name)}>Open →</button>}</span></div>)}</div>;
}

function RestaurantOverview({ company, tables, orders, onTables, onOrders }: { company: string; tables: DiningTable[]; orders: Order[]; onTables: () => void; onOrders: () => void }) {
  const pending = orders.filter((order) => order.state === "pending").length;
  return <><div className="welcome-strip"><div><span className="eyebrow">LIVE AT {company.toUpperCase()}</span><h2>Your floor is moving smoothly.</h2><p>{tables.filter((table) => table.state !== "available").length} tables are active and {pending} order needs attention.</p></div><button className="button light" onClick={onTables}>Open a table</button></div><div className="metric-grid"><Metric label="Sales today" value="$2,840" delta="↑ 8.2% from Friday" icon="$" /><Metric label="Open tables" value={`${tables.filter((t) => t.state !== "available").length}/${tables.length}`} delta="Floor capacity" icon="▦" /><Metric label="Pending approval" value={String(pending)} delta="Needs a waiter" icon="!" /><Metric label="Average bill" value="$71.40" delta="Today" icon="◉" /></div><section className="section split"><div className="panel"><div className="section-head"><div><h2>Orders needing attention</h2><p>Accept customer orders before they reach the kitchen.</p></div><button className="text-button" onClick={onOrders}>All orders →</button></div>{orders.slice(0, 3).map((order) => <div className="order-mini" key={order.id}><span className={`order-dot ${order.state}`} /><span><strong>{order.table} · {order.id}</strong><small>{order.items}</small></span><b>{money(order.total)}</b></div>)}</div><div className="panel"><div className="section-head"><div><h2>Table pulse</h2><p>A quick view of the dining room.</p></div><button className="text-button" onClick={onTables}>Manage →</button></div><div className="mini-floor">{tables.map((table) => <div key={table.id} className={`mini-table ${table.state}`}><span>{table.label.replace("Table ", "T")}</span><small>{table.state.replace("_", " ")}</small></div>)}</div></div></section></>;
}

function TablesView({ tables, onOpen, onQr, onClose, cashier }: { tables: DiningTable[]; onOpen: (table: DiningTable) => void; onQr: (table: DiningTable) => void; onClose: (table: DiningTable) => void; cashier: boolean }) {
  return <section className="section"><div className="section-head"><div><h2>{cashier ? "Payments & tables" : "Dining room"}</h2><p>Open a table to create its one-time customer QR code.</p></div><div className="legend"><span><i className="legend-dot available" />Available</span><span><i className="legend-dot open" />Open</span><span><i className="legend-dot bill_requested" />Bill requested</span></div></div><div className="table-grid">{tables.map((table) => <article className={`table-card ${table.state}`} key={table.id}><div className="table-card-top"><span className="table-icon">⌑</span><em>{table.state.replace("_", " ")}</em></div><h3>{table.label}</h3><p>{table.seats} seats {table.openedAt ? `· Opened ${table.openedAt}` : "· Ready for guests"}</p>{table.state === "available" ? <button className="button primary full-button" onClick={() => onOpen(table)}>Open table & create QR</button> : <div className="dual-actions"><button className="button secondary" onClick={() => onQr(table)}>View QR</button><button className="button danger" onClick={() => onClose(table)}>{cashier ? "Record payment" : "Close"}</button></div>}</article>)}</div></section>;
}

function OrdersView({ orders, portal, onUpdate }: { orders: Order[]; portal: Portal; onUpdate: (id: string, state: OrderState) => void }) {
  const kitchen = portal === "kitchen";
  const visible = kitchen ? orders.filter((order) => !["pending", "rejected", "voided"].includes(order.state)) : orders;
  return <section className="section"><div className="section-head"><div><h2>{kitchen ? "Kitchen board" : "Live orders"}</h2><p>{kitchen ? "Only waiter-approved orders appear here." : "Review, accept and track every table order."}</p></div><span className="live-pill">● LIVE</span></div><div className="order-board">{visible.map((order) => <article className="order-card" key={order.id}><div className="order-card-head"><span><strong>{order.table}</strong><small>{order.id} · {order.time}</small></span><em className={`status ${order.state}`}>{order.state}</em></div><p>{order.items}</p><div className="order-card-bottom"><b>{money(order.total)}</b><div>{order.state === "pending" && !kitchen && <><button className="button danger subtle" onClick={() => onUpdate(order.id, "rejected")}>Reject</button><button className="button primary small" onClick={() => onUpdate(order.id, "accepted")}>Accept order</button></>}{order.state === "accepted" && <button className="button primary small" onClick={() => onUpdate(order.id, "preparing")}>Start preparing</button>}{order.state === "preparing" && <button className="button primary small" onClick={() => onUpdate(order.id, "ready")}>Mark ready</button>}{order.state === "ready" && <button className="button secondary small" onClick={() => onUpdate(order.id, "served")}>Mark served</button>}{order.state === "served" && <button className="text-button" onClick={() => { const reason = window.prompt("Required void reason"); if (reason) onUpdate(order.id, "voided"); }}>Void with reason</button>}</div></div></article>)}</div></section>;
}

function MenuView({ menu, onToggle, onAdd }: { menu: MenuItem[]; onToggle: (id: number) => void; onAdd: () => void }) {
  return <section className="section"><div className="section-head"><div><h2>Menu</h2><p>Simple, clear items for quick mobile ordering.</p></div><button className="button primary" onClick={onAdd}>＋ Add menu item</button></div><div className="panel menu-list">{menu.map((item) => <div className="menu-admin-row" key={item.id}><span className="menu-thumb">{item.name.charAt(0)}</span><span><strong>{item.name}</strong><small>{item.category} · {item.description}</small></span><b>{money(item.price)}</b><button className={`toggle ${item.available ? "on" : ""}`} onClick={() => onToggle(item.id)} aria-label={`Toggle ${item.name}`}><i /></button></div>)}</div></section>;
}

function TeamView() { const members = [["Jordan Ellis", "Owner", "JE"], ["Sam Carter", "Manager", "SC"], ["Nina Brooks", "Waiter", "NB"], ["Theo King", "Kitchen", "TK"], ["Ava Price", "Cashier", "AP"]]; return <section className="section"><div className="section-head"><div><h2>Team</h2><p>Everyone has access only to the tools their role needs.</p></div><button className="button primary">＋ Invite staff member</button></div><div className="panel team-grid">{members.map(([name, role, initials]) => <div className="member" key={name}><span className="member-avatar">{initials}</span><span><strong>{name}</strong><small>{role}</small></span><em className="status active">● Active</em><button className="text-button">Edit</button></div>)}</div></section>; }

function FinanceView() { return <section className="section"><div className="section-head"><div><h2>Finances</h2><p>Offline payments recorded from finalized table sessions.</p></div><button className="button secondary">Export report</button></div><div className="metric-grid"><Metric label="Gross sales" value="$24,680" delta="This month" icon="$" /><Metric label="Tax collected" value="$1,941" delta="8.5% configured" icon="%" /><Metric label="Service charges" value="$2,174" delta="Owner configured" icon="+" /><Metric label="Discounts" value="$684" delta="27 applied" icon="−" /></div><div className="panel finance-chart"><div className="section-head"><div><h2>Seven-day sales</h2><p>Finalized receipts only.</p></div><strong>$8,420</strong></div><div className="bars">{[48, 68, 56, 81, 72, 96, 84].map((height, index) => <div key={index}><i style={{ height: `${height}%` }} /><span>{["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][index]}</span></div>)}</div></div></section>; }

function RestaurantSettings({ company, setCompany, tax, setTax, service, setService, serviceKind, setServiceKind }: { company: string; setCompany: (value: string) => void; tax: string; setTax: (value: string) => void; service: string; setService: (value: string) => void; serviceKind: string; setServiceKind: (value: string) => void }) { return <section className="section settings-wrap"><div className="panel"><div className="section-head"><div><h2>Restaurant settings</h2><p>Only the owner can change billing rules.</p></div></div><div className="settings-form"><label>Company name<input value={company} onChange={(e) => setCompany(e.target.value)} /></label><label>Currency<select defaultValue="USD"><option>USD — US Dollar</option></select></label><label>Tax added to final bill (%)<input value={tax} type="number" onChange={(e) => setTax(e.target.value)} placeholder="—" /></label><label>Service charge type<select value={serviceKind} onChange={(e) => setServiceKind(e.target.value)}><option value="percentage">Percentage</option><option value="fixed">Fixed USD</option></select></label><label>Service charge<input value={service} type="number" onChange={(e) => setService(e.target.value)} placeholder="—" /></label><button className="button primary">Save settings</button></div></div></section>; }

function PlatformSettings() { return <section className="section settings-wrap"><div className="panel"><div className="section-head"><div><h2>Platform settings</h2><p>Super Admin account and DineQR defaults.</p></div></div><div className="settings-form"><label>Platform name<input defaultValue="DineQR" /></label><label>Default currency<select defaultValue="USD"><option>USD — US Dollar</option></select></label><label>Super Admin email<input defaultValue="admin@dineqr.com" /></label><button className="button primary">Save settings</button></div></div></section>; }

function CustomerMenu({ company, menu, cart, subtotal, onAdd, onOrder, onExit, onRequest }: { company: string; menu: MenuItem[]; cart: CartItem[]; subtotal: number; onAdd: (item: MenuItem) => void; onOrder: () => void; onExit: () => void; onRequest: (type: string) => void }) {
  const [category, setCategory] = useState("All");
  const categories = ["All", ...Array.from(new Set(menu.map((item) => item.category)))];
  return <div className="customer-page"><header className="customer-header"><button className="brand dark" onClick={onExit}><span className="brand-mark">D</span><span>DineQR</span></button><span className="customer-company"><small>YOU'RE DINING AT</small><strong>{company}</strong></span><span className="table-badge">Table 01</span></header><section className="customer-hero"><span className="eyebrow">WELCOME TO {company.toUpperCase()}</span><h1>Good food,<br /><i>at your fingertips.</i></h1><p>Choose what you love. Your waiter will approve the order before it reaches the kitchen.</p><div className="request-buttons"><button onClick={() => onRequest("Waiter")}>Raise a hand · Request waiter</button><button onClick={() => onRequest("Bill")}>Request the bill</button></div></section><div className="customer-layout"><div className="customer-menu"><div className="category-tabs">{categories.map((item) => <button key={item} className={category === item ? "active" : ""} onClick={() => setCategory(item)}>{item}</button>)}</div><div className="food-grid">{menu.filter((item) => item.available && (category === "All" || item.category === category)).map((item, index) => <article className="food-card" key={item.id}><div className={`food-photo food-${index % 4}`}><span>{item.category}</span></div><div><small>{item.category}</small><h3>{item.name}</h3><p>{item.description}</p><footer><b>{money(item.price)}</b><button onClick={() => onAdd(item)} aria-label={`Add ${item.name}`}>＋</button></footer></div></article>)}</div></div><aside className="cart"><div><span className="eyebrow">YOUR TABLE</span><h2>Your order</h2></div>{cart.length === 0 ? <div className="empty-cart"><span>⌑</span><strong>Your cart is waiting</strong><p>Add something delicious from the menu.</p></div> : <div className="cart-items">{cart.map((item) => <div key={item.id}><span><strong>{item.quantity} × {item.name}</strong><small>{money(item.price)} each</small></span><b>{money(item.price * item.quantity)}</b></div>)}</div>}<div className="cart-total"><span>Subtotal</span><b>{money(subtotal)}</b><small>Tax and service charge appear on the final bill.</small></div><button className="button primary full-button" disabled={!cart.length} onClick={onOrder}>Send order for approval</button></aside></div><footer className="customer-footer"><span>{company}</span><small>Powered by DineQR · This secure menu expires when your table closes.</small></footer></div>;
}

function Metric({ label, value, delta, icon }: { label: string; value: string; delta: string; icon: string }) { return <div className="metric"><span className="metric-icon">{icon}</span><span><small>{label}</small><strong>{value}</strong><em>{delta}</em></span></div>; }
function Activity({ color, title, note }: { color: string; title: string; note: string }) { return <div className="activity-row"><i className={color} /><span><strong>{title}</strong><small>{note}</small></span></div>; }
function Modal({ title, onClose, children }: { title: string; onClose: () => void; children: React.ReactNode }) { return <div className="modal-backdrop" role="dialog" aria-modal="true"><div className="modal"><div className="modal-head"><h2>{title}</h2><button onClick={onClose} aria-label="Close">×</button></div>{children}</div></div>; }
